# 서울 열린데이터광장 인증키 (주차 API: GetParkingInfo, GetParkInfo 등)
# 이 파일을 .env로 복사해서 값을 넣어요. .env는 저장소에 올라가지 않아요.
SEOUL_OPEN_API_KEY=

# 제출용 release 서명 (python3 tools/build_release.py). 비워 두면 서명이 없어 설치할 수 없는 APK가 만들어져요.
# 키 파일은 .signing/ 아래에 두고, 저장소에는 올리지 않아요.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
