<?xml version="1.0" encoding="utf-8"?>
<!-- 하차 순간의 위치 기록, 가로 전체 창용 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/parked_title"
            style="@style/Text.HeadlineS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/parked_sub"
            style="@style/Text.BodyL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_3" />

        <LinearLayout
            android:id="@+id/floor_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/fee_card"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.TitleS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="요금 안내" />

            <TextView
                android:id="@+id/fee_step"
                style="@style/Text.BodyL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/text_2" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/fee_summary_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.LabelM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="요금" />

            <TextView
                android:id="@+id/fee_summary"
                style="@style/Text.TitleS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="700dp"
        android:layout_height="match_parent"
        android:layout_marginStart="40dp"
        android:orientation="vertical">

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/qr_image"
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:background="@color/basic_00"
                android:contentDescription="휴대폰으로 위치 받기 QR"
                android:padding="12dp" />

            <TextView
                style="@style/Text.TitleM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="휴대폰으로 위치 받기" />

            <TextView
                android:id="@+id/qr_desc"
                style="@style/Text.BodyM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/text_3" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_parked_done"
            style="@style/Button.Basic"
            android:layout_width="match_parent"
            android:text="닫기" />
    </LinearLayout>
</LinearLayout>
