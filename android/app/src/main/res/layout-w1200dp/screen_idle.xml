<?xml version="1.0" encoding="utf-8"?>
<!-- 기다리는 화면: 연결 상태, 마지막 주차 위치, 시연 시나리오 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Text.HeadlineS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="P단에 두면 바로 확인해 드릴게요" />

        <TextView
            style="@style/Text.BodyL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingMultiplier="1.3"
            android:text="차를 세운 자리의 단속 CCTV, 소화전, 횡단보도, 어린이보호구역을 확인하고 가까운 주차장의 빈자리를 함께 알려 드려요."
            android:textColor="@color/text_2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.BodyM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기어"
                    android:textColor="@color/text_3" />

                <TextView
                    android:id="@+id/gear_value"
                    style="@style/Text.HeadlineM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="–" />

                <TextView
                    android:id="@+id/vehicle_state"
                    style="@style/Text.LabelM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.BodyM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="위치"
                    android:textColor="@color/text_3" />

                <TextView
                    android:id="@+id/location_value"
                    style="@style/Text.TitleS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="–" />

                <TextView
                    android:id="@+id/location_source"
                    style="@style/Text.LabelM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.BodyM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="실시간 빈자리"
                    android:textColor="@color/text_3" />

                <TextView
                    android:id="@+id/live_value"
                    style="@style/Text.TitleM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="–" />

                <TextView
                    android:id="@+id/live_note"
                    style="@style/Text.LabelM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/record_card"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.BodyM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="마지막 주차 위치 · 누르면 QR을 다시 보여 드려요"
                android:textColor="@color/text_3" />

            <TextView
                android:id="@+id/record_value"
                style="@style/Text.TitleM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/report_card"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                style="@style/Text.BodyM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이번 달 리포트 · 누르면 자세히 보여 드려요"
                android:textColor="@color/text_3" />

            <TextView
                android:id="@+id/report_card_value"
                style="@style/Text.BodyL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="700dp"
        android:layout_height="match_parent"
        android:layout_marginStart="40dp"
        android:orientation="vertical">

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.TitleS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시연 위치" />

            <TextView
                style="@style/Text.LabelM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="에뮬레이터 내비 위치는 한곳에 고정이라, P단 판단에 쓸 위치를 고를 수 있어요." />

            <LinearLayout
                android:id="@+id/scenario_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_check_now"
            style="@style/Button.Filled"
            android:layout_width="match_parent"
            android:text="지금 위치 확인" />
    </LinearLayout>
</LinearLayout>
