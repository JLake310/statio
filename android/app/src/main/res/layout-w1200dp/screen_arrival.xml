<?xml version="1.0" encoding="utf-8"?>
<!-- 도착 전 주차장 비교, 가로 전체 창용 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/arrival_title"
            style="@style/Text.HeadlineS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/arrival_sub"
            style="@style/Text.BodyL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_3" />

        <LinearLayout
            android:id="@+id/arrival_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            style="@style/Text.LabelM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/arrival_notice"
            android:text="@string/arrival_notice" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="700dp"
        android:layout_height="match_parent"
        android:layout_marginStart="40dp"
        android:orientation="vertical">

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.BodyM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="목적지"
                android:textColor="@color/text_3" />

            <TextView
                android:id="@+id/arrival_dest_name"
                style="@style/Text.TitleL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/arrival_dest_info"
                style="@style/Text.BodyM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_2" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_arrival_route"
            style="@style/Button.Filled"
            android:layout_width="match_parent"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />

        <TextView
            android:id="@+id/btn_arrival_close"
            style="@style/Button.Basic"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:text="닫기" />
    </LinearLayout>
</LinearLayout>
