<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/risk_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@drawable/bg_divider_bad" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/risk_row_padding"
        android:paddingBottom="@dimen/risk_row_padding">

        <View
            android:id="@+id/risk_dot"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/dot" />

        <TextView
            android:id="@+id/risk_label"
            style="@style/Text.TitleS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp" />

        <TextView
            android:id="@+id/risk_name"
            style="@style/Text.BodyM"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_3" />

        <TextView
            android:id="@+id/risk_value"
            style="@style/Text.TitleM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/negative" />
    </LinearLayout>
</LinearLayout>
