<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/basic_00"
    android:orientation="vertical"
    android:paddingStart="44dp"
    android:paddingTop="40dp"
    android:paddingEnd="44dp"
    android:paddingBottom="40dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Text"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_logo"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/basic_00"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/app_name"
            android:textSize="30sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/status_chip"
            style="@style/Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1">

        <include
            android:id="@+id/idle"
            layout="@layout/screen_idle" />

        <include
            android:id="@+id/check"
            layout="@layout/screen_check"
            android:visibility="gone" />

        <include
            android:id="@+id/arrival"
            layout="@layout/screen_arrival"
            android:visibility="gone" />

        <include
            android:id="@+id/parked"
            layout="@layout/screen_parked"
            android:visibility="gone" />

        <include
            android:id="@+id/report"
            layout="@layout/screen_report"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
