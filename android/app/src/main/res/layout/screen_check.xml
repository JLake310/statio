<?xml version="1.0" encoding="utf-8"?>
<!-- P단 순간의 판단 화면, 세로 분할 창용 (가로 전체 창은 layout-w1200dp) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/verdict_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_warn"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="24dp"
        android:paddingEnd="36dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/verdict_icon"
                style="@style/Text"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_icon_bad"
                android:gravity="center"
                android:text="!"
                android:textColor="@color/basic_00"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/verdict_title"
                style="@style/Text.TitleL"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:textColor="@color/negative" />
        </LinearLayout>

        <TextView
            android:id="@+id/verdict_place"
            style="@style/Text.BodyM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/text_2" />

        <LinearLayout
            android:id="@+id/risk_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/Text.LabelS"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/notice" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/CheckCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fine_label"
                style="@style/Text.BodyS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_3" />

            <TextView
                android:id="@+id/fine_value"
                style="@style/Text.HeadlineS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/negative" />

            <TextView
                android:id="@+id/fine_note"
                style="@style/Text.LabelM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            style="@style/CheckCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.BodyS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="주차장에 세우면"
                android:textColor="@color/text_3" />

            <TextView
                android:id="@+id/lot_fee_value"
                style="@style/Text.HeadlineS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/active" />

            <TextView
                android:id="@+id/lot_fee_note"
                style="@style/Text.LabelM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lot_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical" />

    <!-- 남는 높이만큼 약도를 보여 줘요. 너무 낮으면 약도는 그리지 않아요.
         범례 칩은 위 위험 목록·주차장 카드와 내용이 같고 낮은 약도를 가려서, 세로 분할 창에서는 숨겨요. -->
    <FrameLayout
        android:id="@+id/map_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_map"
        android:clipToOutline="true">

        <com.statio.app.ui.RiskMapView
            android:id="@+id/risk_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/legend_risk"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_bad"
                android:textColor="@color/negative" />

            <TextView
                android:id="@+id/legend_lot"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_chip_ok"
                android:textColor="@color/active_text" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_route"
            style="@style/Button.Filled"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:text="주차장으로 안내" />

        <TextView
            android:id="@+id/btn_dismiss"
            style="@style/Button.Basic"
            android:layout_width="0dp"
            android:layout_marginStart="16dp"
            android:layout_weight="2"
            android:text="잠깐만 세울게요" />
    </LinearLayout>
</LinearLayout>
