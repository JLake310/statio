<?xml version="1.0" encoding="utf-8"?>
<!-- 도착 전 주차장 비교, 세로 분할 창용 (design/png/01_도착전_주차장비교.png) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/arrival_title"
        style="@style/Text.TitleL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/arrival_sub"
        style="@style/Text.BodyM"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_3" />

    <LinearLayout
        android:id="@+id/arrival_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        style="@style/Text.LabelS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:id="@+id/arrival_notice"
        android:text="@string/arrival_notice" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_arrival_route"
            style="@style/Button.Filled"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />

        <TextView
            android:id="@+id/btn_arrival_close"
            style="@style/Button.Basic"
            android:layout_width="0dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="닫기" />
    </LinearLayout>
</LinearLayout>
